# Quick-start environment for Docker Compose (development only)
# Override these with secure values in production
# WARNING: Development-only defaults. In production, always set
# MONGO_INITDB_ROOT_PASSWORD to a strong unique value via environment variable.
MONGO_INITDB_ROOT_USERNAME=admin
# dev-only password — never use in production
MONGO_INITDB_ROOT_PASSWORD=dev-only-changeme
