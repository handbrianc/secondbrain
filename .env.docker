# Environment contract for the production Compose stack (docker-compose.yml).
#
# Loaded into the `mcp-server` service via `env_file`; every value is
# runtime-injectable, so the stack can target external infrastructure with no
# image rebuild. This file ships safe placeholders only — the deployment's
# real endpoints and keys live in an uncommitted local copy (redacted from
# the repository); fill in your own values locally and keep real secrets
# out of version control.
#
# Restart the stack (`docker compose up -d`) after changing anything here.
#
# The bundled services: Qdrant (vector DB, published on localhost:6333 for
# host-side CLI tooling; comment the ports block in docker-compose.yml to make
# it internal-only) and the MCP server (primary, host port 8080). Conversation
# sessions persist in SQLite inside the `secondbrain-sqlite` volume.

# ============================================================================
# MCP server settings (SECONDBRAIN_MCP_*)
# ============================================================================
# Address the server binds inside the container (image default; the host
# exposure is compose's `ports: ["8080:8080"]`).
SECONDBRAIN_MCP_HTTP_BIND_ADDR=0.0.0.0:8080

# Ingest path allow-list root: the only tree MCP tool calls may read from.
# Compose mounts the host `./workspace` read-only here.
SECONDBRAIN_MCP_WORKSPACE_ROOT=/data/workspace

# Upload staging for the `upload_document` tool: the decoded bytes land here
# (default: the `uploads` directory inside the workspace root) and compose
# layers the host `./workspace/uploads` read-write over it; the image
# entrypoint hands the directory to the runtime user at startup, so an
# auto-created host directory works too. Uncomment to use a different
# in-workspace directory (then adjust the compose mount to match).
# SECONDBRAIN_MCP_UPLOAD_DIR=uploads

# Decoded upload size cap for `upload_document` (code default 10485760 = 10 MB).
# The stack runs at 100 MB (104857600): large PDFs upload in one call, and the
# derived `/mcp` request-body budget grows with it (ceil(cap × 4/3) + 1 MiB
# ≈ 141 MB). The CLI's own 100 MiB per-file processing cap still applies at
# ingest time.
SECONDBRAIN_MCP_UPLOAD_MAX_BYTES=104857600

# Binary the server drives for ingest/search/chat (the image ships the
# `secondbrain` CLI on PATH next to the server binary).
SECONDBRAIN_MCP_CLI_BIN=secondbrain

# Seconds before the server kills a runaway CLI subprocess.
SECONDBRAIN_MCP_SUBPROCESS_TIMEOUT_SECONDS=900

# Server log filter (trace|debug|info|warn|error, case-insensitive).
SECONDBRAIN_MCP_LOG_LEVEL=info

# TLS: uncomment to serve HTTPS on the same port, and also uncomment the
# `./certs` mount in docker-compose.yml (read-only at /certs). Paths are
# container-side. Note: the image's HEALTHCHECK probes plaintext HTTP —
# override it in compose (e.g. an https probe skipping local certificate
# verification) when TLS is enabled.
# SECONDBRAIN_MCP_HTTP_TLS_ENABLED=true
# SECONDBRAIN_MCP_HTTP_TLS_CERT_PATH=/certs/server.crt
# SECONDBRAIN_MCP_HTTP_TLS_KEY_PATH=/certs/server.key

# Host allow-list on /mcp (rmcp's DNS-rebinding protection): by default only
# localhost / 127.0.0.1 / ::1 are admitted. Uncomment to admit the hostname
# clients actually use (comma-separated; an entry with a port must match
# exactly; the list replaces the default, it does not extend it).
SECONDBRAIN_MCP_HTTP_ALLOWED_HOSTS=mcp.internal.example.com

# Bearer auth: uncomment to require `Authorization: Bearer <token>` on the
# /mcp endpoint (unauthenticated requests receive 401; /healthz stays open).
# SECONDBRAIN_MCP_AUTH_TOKEN=change-me-to-a-long-random-value

# ============================================================================
# Storage: bundled Qdrant + SQLite
# ============================================================================
SECONDBRAIN_STORAGE_BACKEND=qdrant

# Default: the bundled, healthchecked qdrant service over the internal
# network. To use an external Qdrant instead, point this at it (e.g.
# http://your-qdrant-host:6333) — no image rebuild needed.
SECONDBRAIN_QDRANT_URL=http://secondbrain-qdrant:6333
SECONDBRAIN_QDRANT_COLLECTION=embeddings
# Uncomment if the target Qdrant requires an API key.
# SECONDBRAIN_QDRANT_API_KEY=

# SQLite conversation storage, inside the persisted `secondbrain-sqlite`
# volume (mounted at /data/secondbrain).
SECONDBRAIN_SQLITE_PATH=/data/secondbrain/secondbrain.db

# ============================================================================
# Embedding API (OpenAI-compatible; required for ingest and search)
# ============================================================================
# The CLI talks to any OpenAI-compatible embedding endpoint (OpenAI, vLLM,
# LM Studio, Ollama, ...). Dimensions must match the model in use.
SECONDBRAIN_EMBEDDING_PROVIDER=openai
SECONDBRAIN_EMBEDDING_API_KEY=
SECONDBRAIN_EMBEDDING_API_BASE=http://litellm.internal.example.com:4000
SECONDBRAIN_EMBEDDING_DIMENSIONS=768
SECONDBRAIN_EMBEDDING_MODEL=embeddinggemma-300m.f16

# ============================================================================
# LLM API (required for chat)
# ============================================================================
# Provider: openai (any OpenAI-compatible endpoint) or anthropic.
SECONDBRAIN_LLM_PROVIDER=openai
SECONDBRAIN_OPENAI_BASE_URL=http://litellm.internal.example.com:4000
SECONDBRAIN_OPENAI_API_KEY=
SECONDBRAIN_LLM_API_KEY=
SECONDBRAIN_LLM_MODEL="GLM-5.3-Flash"

# Anthropic provider: set when SECONDBRAIN_LLM_PROVIDER=anthropic.
# SECONDBRAIN_ANTHROPIC_API_KEY=

# LLM Configuration
SECONDBRAIN_CHUNK_SIZE=512
SECONDBRAIN_LLM_MAX_TOKENS=384000
SECONDBRAIN_LLM_REASONING_EFFORT=low
SECONDBRAIN_SHOW_THINKING=0
SECONDBRAIN_CHUNK_OVERLAP=50
# Two worker processes: four parallel docling workers OOM-killed each other on
# the 6 GiB host during heavy PDF parses (kernel oom_kill in the server
# container's cgroup → CLI BrokenProcessPool). Explicit per-call --cores still
# wins over this cap (see config/processing.py precedence).
SECONDBRAIN_MAX_WORKERS=2
SECONDBRAIN_RATE_LIMIT_ENABLED=true
SECONDBRAIN_CIRCUIT_BREAKER_ENABLED=true
SECONDBRAIN_PDF_STRUCTURE_PROBE_ENABLED=true
SECONDBRAIN_RAG_MAX_CONTEXT_CHARS=384000

# Logging
SECONDBRAIN_LOG_LEVEL=WARNING
SECONDBRAIN_LOG_FORMAT=pretty
