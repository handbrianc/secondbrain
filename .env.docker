# Quick-start environment for Docker Compose (development only)
# Override these with secure values in production
#
# The Docker Compose stack runs Qdrant (vector DB) and stores conversation
# sessions in SQLite. MongoDB was removed, so no MONGO_INITDB_* variables exist.
SECONDBRAIN_STORAGE_BACKEND=qdrant
SECONDBRAIN_QDRANT_URL=http://localhost:6333
SECONDBRAIN_QDRANT_COLLECTION=embeddings
